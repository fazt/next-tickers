// Prisma 7: la URL de conexión vive en prisma.config.ts y el cliente se
// genera dentro de src/ (generator "prisma-client").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  BILLING
  ACCOUNT
  FEATURE_REQUEST
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  // Un admin puede desactivar cuentas en lugar de borrarlas (conservan su historial).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticketsCreated  Ticket[]      @relation("TicketAuthor")
  ticketsAssigned Ticket[]      @relation("TicketAssignee")
  comments        Comment[]
  ticketEvents    TicketEvent[]
}

model Ticket {
  id          String         @id @default(cuid())
  // Número legible para mostrar (#1024) sin exponer el id interno.
  number      Int            @unique @default(autoincrement())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    TicketCategory @default(GENERAL)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  authorId   String
  author     User    @relation("TicketAuthor", fields: [authorId], references: [id])
  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments Comment[]
  events   TicketEvent[]

  @@index([status])
  @@index([priority])
  @@index([authorId])
  @@index([assigneeId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

// Historial de un ticket: creación, cambios de estado y prioridad, y asignaciones.
model TicketEvent {
  id        String          @id @default(cuid())
  type      TicketEventType
  fromValue String?
  toValue   String?
  createdAt DateTime        @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId  String
  actor    User   @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}
