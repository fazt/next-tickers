# Copia este archivo a .env y ajusta los valores.

# PostgreSQL. Coincide con docker-compose.yml (contenedor next-tickers-db, puerto 5462).
DATABASE_URL="postgresql://tickets:tickets@localhost:5462/next_tickers?schema=public"

# Secreto para firmar y cifrar las sesiones (JWT) de NextAuth.
# Genera uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (en producción, el dominio con https).
NEXTAUTH_URL="http://localhost:3000"
